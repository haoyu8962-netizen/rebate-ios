# SwiftFormat：tools/ci/verify.sh 运行 swiftformat --lint .
--swiftversion 6.0
--languagemode 6
--indent 4
--ifdef no-indent
--ranges no-space
--maxwidth 120
# Codex 先写的 OpenTradeVectorTests.swift（APP-06b）、ClipboardVectorTests.swift（APP-07）、OrderVectorTests.swift（APP-08）、WalletVectorTests.swift（APP-09）、MeVectorTests.swift（APP-12）约定不改：排除在格式检查之外（import 顺序与条件赋值写法与本仓库风格不同）。
--exclude Packages/Generated/Sources,App/Sources/Generated,Packages/*/.build,.build,DerivedData,Couli.xcodeproj,tools/ci/lint-fixtures,Packages/Features/Tests/TradeTests/OpenTradeVectorTests.swift,Packages/Core/Tests/ClipboardTests/ClipboardVectorTests.swift,Packages/Core/Tests/OrderCoreTests/OrderVectorTests.swift,Packages/Core/Tests/WalletCoreTests/WalletVectorTests.swift,Packages/Core/Tests/MeCoreTests/MeVectorTests.swift
# 与 Codex 先写的 ContractConformanceTests 风格一致所需的放宽。
--disable hoistTry,docComments,wrapMultilineStatementBraces,numberFormatting
