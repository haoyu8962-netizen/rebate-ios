    {"id": "known.no_rebate", "texts": "contract", "card": {"rebate_basis": "no_rebate", "rebate_min_fen": 0, "rebate_max_fen": 0, "est_net_price_fen": null, "cta": {"text_key": "btn.buy.no_rebate"}}, "buyEnabled": true,
