{
  "version": 1,
  "source": "D10-856 / D10-857（FU-X-CTA-KEY-DRIFT）；rebate-platform a89c1ec3a（CT-26t #2450）contracts/texts.default.json 与 openapi ProductCta 描述；couli 规划/08_业务规则/12_TEXT_话术与格式.md BR-TEXT-12 细则「购买按钮」、BR-TEXT-14 表 C btn.buy.rebate / btn.buy.rebate_unknown（2026-11-05）。三端照抄，逐字节一致。",
  "contractCommit": "a89c1ec3a7f4de0b069742af909eba6545358ea3",
  "rules": [
    "R1 锁内有的 cta.text_key：显示字典原文；原文带 {amount} 时用同一张卡的单一返利金额（与返利标签同一格式化结果，BR-TEXT-10）填上。",
    "R2 渲染不出完整文案（texts 返回空串、返回键名本身、或填完已知变量后仍有 {变量}）即为缺键：改用 btn.buy 的文案（先经 texts，texts 给不出可用文字时用包内契约字典），按钮状态照常按价格、下架、平台状态判（缺键本身不置灰）。",
    "R3 每次映射遇到缺键记一条诊断，只带 text_key 原值，不带商品、用户、链接等任何字段。",
    "R4 没有 cta 或 text_key 为空串：不兜底，按钮禁用（服务端违约，与现状一致），不记诊断。"
  ],
  "textsModes": {
    "contract": "texts(key) = 包内契约字典 texts[key]，没有则空串",
    "echo": "texts(key) = 包内契约字典 texts[key]，没有则返回 key 本身（首页文案函数的写法）",
    "none": "texts(key) 一律空串"
  },
  "harness": "每条 case：baseCard 逐字段被 card 覆盖（值为 null 表示删掉该字段）；按 texts 模式与 buyEnabled 调一次卡片映射（列表卡与详情大卡同一映射）；expect.buyBase 为按钮动词，state 为 normal / disabled / retry_later，diagnostic 为这次映射记下的唯一一条诊断的 text_key（null 表示一条都不记）；title 按所在页面（list / detail / agent）给出 normal 状态下按钮上的整行文字，缺的页面不判定。",
  "baseCard": {
    "platform": "taobao", "product_key": "tb:cta", "item_ref": "ref-cta", "link_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5c01",
    "title": "洗衣液 3kg", "price_fen": 3990, "coupon_fen": 1000, "final_price_fen": 2990, "est_net_price_fen": 2721,
    "rebate_min_fen": 269, "rebate_max_fen": 269, "rebate_basis": "normal", "benefit_tags": [], "is_presale": false,
    "cta": {"text_key": "btn.buy.rebate"}, "quoted_at": "2026-11-07T09:30:00+08:00", "stale": false, "age_sec": 12,
    "disclaimer_keys": ["price_basis"], "availability": "ok"
  },
  "cases": [
    {"id": "known.rebate.list", "texts": "contract", "card": {}, "buyEnabled": true,
     "expect": {"buyBase": "购买预估返 ¥2.69", "state": "normal", "diagnostic": null, "title": {"list": "购买预估返 ¥2.69", "detail": "购买预估返 ¥2.69", "agent": "购买预估返 ¥2.69"}},
     "note": "R1：btn.buy.rebate「购买预估返 {amount}」，{amount} = 同卡返利 ¥2.69；动词已含金额，不再拼「 · 预估返」后缀"},
    {"id": "known.rebate.echo", "texts": "echo", "card": {}, "buyEnabled": true,
     "expect": {"buyBase": "购买预估返 ¥2.69", "state": "normal", "diagnostic": null, "title": {"list": "购买预估返 ¥2.69"}},
     "note": "R1：texts 缺键回键名的写法不影响已知键"},
    {"id": "known.rebate.one_fen", "texts": "contract", "card": {"rebate_min_fen": 1, "rebate_max_fen": 1, "est_net_price_fen": 2989}, "buyEnabled": true,
     "expect": {"buyBase": "购买预估返 ¥0.01", "state": "normal", "diagnostic": null, "title": {"detail": "购买预估返 ¥0.01"}},
     "note": "R1：最小金额 1 分"},
    {"id": "known.rebate.whole_yuan", "texts": "contract", "card": {"rebate_min_fen": 500, "rebate_max_fen": 500, "est_net_price_fen": 2490}, "buyEnabled": true,
     "expect": {"buyBase": "购买预估返 ¥5", "state": "normal", "diagnostic": null, "title": {"list": "购买预估返 ¥5"}},
     "note": "R1：整元去掉末尾 0（BR-TEXT-10）"},
    {"id": "known.rebate.large", "texts": "contract", "card": {"price_fen": 300000, "coupon_fen": 0, "final_price_fen": 300000, "rebate_min_fen": 123456, "rebate_max_fen": 123456, "est_net_price_fen": 176544}, "buyEnabled": true,
     "expect": {"buyBase": "购买预估返 ¥1234.56", "state": "normal", "diagnostic": null, "title": {"detail": "购买预估返 ¥1234.56"}},
     "note": "R1：无千分位（BR-TEXT-10）；无券同一句"},
    {"id": "known.rebate_unknown", "texts": "contract", "card": {"rebate_basis": "amount_unknown", "rebate_min_fen": null, "rebate_max_fen": null, "est_net_price_fen": null, "cta": {"text_key": "btn.buy.rebate_unknown"}}, "buyEnabled": true,
     "expect": {"buyBase": "购买可返利", "state": "normal", "diagnostic": null, "title": {"list": "购买可返利", "detail": "购买可返利"}},
     "note": "R1：amount_unknown → btn.buy.rebate_unknown「购买可返利」"},
    {"id": "known.login_to_view", "texts": "contract", "card": {"rebate_basis": "login_required", "rebate_min_fen": null, "rebate_max_fen": null, "est_net_price_fen": null, "cta": {"text_key": "rebate_login_to_view"}}, "buyEnabled": true,
     "expect": {"buyBase": "登录查看返利", "state": "normal", "diagnostic": null},
