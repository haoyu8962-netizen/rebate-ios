    {"id": "unknown.contract", "texts": "contract", "card": {"cta": {"text_key": "btn.buy.future_x"}}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "btn.buy.future_x"},
     "note": "R2/R3：锁内没有的键 → 「购买」、可点、记一条诊断"},
    {"id": "unknown.echo", "texts": "echo", "card": {"cta": {"text_key": "btn.buy.future_x"}}, "buyEnabled": true,
