     "note": "R2：texts 回键名也算缺键，按钮上不出现键名"},
    {"id": "unknown.none", "texts": "none", "card": {"cta": {"text_key": "btn.buy.future_x"}}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "btn.buy.future_x"},
     "note": "R2：texts 连 btn.buy 也给不出时用包内契约字典的 btn.buy"},
    {"id": "unknown.other_prefix", "texts": "contract", "card": {"cta": {"text_key": "cta.next.buy"}}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "cta.next.buy"},
     "note": "R2：不是 btn.buy 前缀的新键同样兜底"},
    {"id": "unknown.no_rebate_card", "texts": "contract", "card": {"rebate_basis": "no_rebate", "rebate_min_fen": 0, "rebate_max_fen": 0, "est_net_price_fen": null, "cta": {"text_key": "btn.buy.future_x"}}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "btn.buy.future_x"},
     "note": "R2：无返利卡上的未知键也只回落「购买」，不自拟无返利文案"},
    {"id": "unrenderable.rebate_range", "texts": "contract", "card": {"rebate_min_fen": 135, "rebate_max_fen": 269}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "btn.buy.rebate"},
