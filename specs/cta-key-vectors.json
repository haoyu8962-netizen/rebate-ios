    {"id": "unrenderable.rebate_zero", "texts": "contract", "card": {"rebate_basis": "no_rebate", "rebate_min_fen": 0, "rebate_max_fen": 0, "est_net_price_fen": null}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "btn.buy.rebate"},
     "note": "R2：btn.buy.rebate 却没有返利，{amount} 填不上 → 「购买」"},
    {"id": "unrenderable.rebate_unknown_basis", "texts": "contract", "card": {"rebate_basis": "amount_unknown", "rebate_min_fen": null, "rebate_max_fen": null, "est_net_price_fen": null}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "btn.buy.rebate"},
     "note": "R2：btn.buy.rebate 却是金额未知 → 「购买」"},
    {"id": "unrenderable.other_placeholder", "texts": "contract", "card": {"cta": {"text_key": "platform_coming_soon"}}, "buyEnabled": true,
     "expect": {"buyBase": "购买", "state": "normal", "diagnostic": "platform_coming_soon"},
