    {"name": "unknown_then_e50001", "dedicated": "RealnameFundsUnknownKeyTests", "sequence": [{"transport": "disconnect"}, {"code": 50001, "data": null}], "expect": {"done": false, "nextSubmit": "same_key"}},
    {"name": "unknown_then_e50401", "dedicated": "RealnameFundsUnknownKeyTests", "sequence": [{"transport": "disconnect"}, {"code": 50401, "data": null}], "expect": {"done": false, "nextSubmit": "same_key"}},
    {"name": "unknown_then_e50301", "dedicated": "RealnameFundsUnknownKeyTests", "sequence": [{"transport": "disconnect"}, {"code": 50301, "data": null}], "expect": {"done": false, "nextSubmit": "same_key"}},
    {"name": "unknown_then_e42901", "dedicated": "RealnameFundsUnknownKeyTests", "sequence": [{"transport": "disconnect"}, {"code": 42901, "data": null, "headers": {"Retry-After": "1"}}], "expect": {"done": false, "nextSubmit": "same_key"}},
    {"name": "unknown_then_e30406", "dedicated": "RealnameFundsUnknownKeyTests", "sequence": [{"transport": "disconnect"}, {"code": 30406, "data": null}], "expect": {"done": false, "nextSubmit": "new_key"}},
    {"name": "e40901_busy", "reply": {"code": 40901, "data": null}, "dedicated": "RealnameFundsKeyTests.test40901KeepsLoadingAndResendsSameKey", "expect": {"done": false, "keepLoading": true, "resend": "same_key_same_body_auto", "maxPostsIn6s": 4}}
  ]
