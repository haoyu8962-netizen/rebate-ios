{
  "schema": "couli-n22-bridge-origins-vectors/1",
  "decision": "D10-2539（三端 N-22 共用；native-android 出）",
  "contract": "contracts/snapshot/contracts/openapi.json components.schemas.ConfigBridgeOrigins（description 即判定规则）",
  "rules_order": [
    "malformed: 三段 base64url、无填充",
    "header: alg = ES256",
    "key: 按 header.kid + 构建 env 取随包公钥，没有即拒",
    "signature: 64 字节 R‖S（P1363）、ECDSA P-256 / SHA-256 over ASCII header.payload",
    "header.typ = couli-bridge-origins+jws",
    "payload: v = 1、app_id = 本应用、env = 本构建 env",
    "payload: version 整数 >= 0 且 >= 上次可用版本（无上次则不比）",
    "payload: origins 非空、每项规范化 https origin（小写主机、无路径 / 查询 / 片段 / 凭据 / 通配、443 省略）",
    "任一失败：保留上次可用白名单（或包内），不把失败值写成上次可用（AC-S1-180 ②）"
  ],
  "reason_codes_note": "expect.reason 只供定位，客户端不必逐字复现；判定只看 accept 与 origins。规则顺序不同导致的 reason 不同可接受，accept 必须一致。",
