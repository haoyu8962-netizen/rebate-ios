// App target 公共设置。关键编译条件（DEBUG / STAGING / 优化级别）写在 project.yml，
// 因为 XcodeGen 的 target 级设置会覆盖 xcconfig；这里只放标识、版本与显示名。

// 三套配置同一个 Bundle ID（02 §3.2，TECH-08）。
PRODUCT_BUNDLE_IDENTIFIER = com.couli.app
// Team ID 未给定，占位留空：见 ../couli-runs/NATIVE/needs.md N-04。
// 现阶段只做模拟器构建与 CODE_SIGNING_ALLOWED=NO 的通用设备构建。
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// routes.json 的 since 以 1.0.0 为首发版本；低于它时所有路由都按「版本过低」进升级提示（APP-02a）。
MARKETING_VERSION = 1.0.0
COULI_BUILD_NUMBER = 1
CURRENT_PROJECT_VERSION = $(COULI_BUILD_NUMBER)
COULI_BUNDLE_VERSION = $(COULI_BUILD_NUMBER)

// /v1/config 的 bridge_origins 验签公钥表（N-22，契约 ConfigBridgeOrigins；Info.plist 的 CouliConfigSignKeys）。
// 格式：空白分隔的若干项 env:kid:<SPKI DER 十六进制>；每个 env 随包两把（current + next，契约 Key rotation）。
// 生产 kid 与公钥由负责人与 ops 提供，给到之前留空：Release 公钥表为空，生产可信白名单为空（WebPage 不开），是保守状态。
COULI_CONFIG_SIGN_KEYS_PROD =
